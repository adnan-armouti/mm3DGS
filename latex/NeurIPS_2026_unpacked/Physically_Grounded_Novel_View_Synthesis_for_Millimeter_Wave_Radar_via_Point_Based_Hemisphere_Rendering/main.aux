\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {3DPS rendering pipeline.} A LiDAR point cloud is reduced to $N{=}20{,}000$ oriented points (Sec.\nobreakspace  {}\ref  {sec:methods:splat}, LiDAR-derived geometric prior). For each (TX,\nobreakspace  {}RX) pair, the per-point ITU BSDF (Sec.\nobreakspace  {}\ref  {sec:methods:bsdf}) is evaluated at the deterministic incidence and observation angles, producing a complex amplitude $A_i^{TR}$ and a carrier phase $\phi _{TRi}$. Each point's complex contribution is splatted via a Hann-windowed PSF into the $L{=}15$ nearest range bins (Eq.\nobreakspace  {}\ref  {eq:psf_splat}). Per-(TX,\nobreakspace  {}RX) range profiles are stacked and an azimuth FFT is applied to obtain the final RA map.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{6}{\textbf {3DPS rendering pipeline.} A LiDAR point cloud is reduced to $N{=}20{,}000$ oriented points (Sec.~\ref {sec:methods:splat}, LiDAR-derived geometric prior). For each (TX,~RX) pair, the per-point ITU BSDF (Sec.~\ref {sec:methods:bsdf}) is evaluated at the deterministic incidence and observation angles, producing a complex amplitude $A_i^{TR}$ and a carrier phase $\phi _{TRi}$. Each point's complex contribution is splatted via a Hann-windowed PSF into the $L{=}15$ nearest range bins (Eq.~\ref {eq:psf_splat}). Per-(TX,~RX) range profiles are stacked and an azimuth FFT is applied to obtain the final RA map}{figure.2}{}}
\newlabel{eq:bsdf_decomp}{{3}{6}{Per-point ITU BSDF}{equation.3.3}{}}
