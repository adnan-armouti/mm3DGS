\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces 3D occupancy evaluation against LiDAR ground truth. Baseline: ColoRadar-provided 3D point cloud from the cascaded radar's near-1D virtual aperture, where elevation is synthesized by extruding range--azimuth detections along the vertical axis due to minimal elevation resolution. Ours: dense virtual array (100TX$\times $100RX) with full 2D aperture enabling range--azimuth--elevation (RAE) imaging. Occupancy metrics use KD-tree nearest neighbors ($\tau {=}0.5$\,m). Best in \textbf  {bold}.\relax }}{13}{table.caption.13}\protected@file@percent }
\newlabel{tab:3d_occupancy}{{4}{13}{3D occupancy evaluation against LiDAR ground truth. Baseline: ColoRadar-provided 3D point cloud from the cascaded radar's near-1D virtual aperture, where elevation is synthesized by extruding range--azimuth detections along the vertical axis due to minimal elevation resolution. Ours: dense virtual array (100TX$\times $100RX) with full 2D aperture enabling range--azimuth--elevation (RAE) imaging. Occupancy metrics use KD-tree nearest neighbors ($\tau {=}0.5$\,m). Best in \textbf {bold}.\relax }{table.caption.13}{}}
\newlabel{tab:3d_occupancy@cref}{{[table][4][]4}{[1][12][]13}}
